PORT=3000
# Optional: the learning portal works without a database; JD Intelligence requires it.
JD_DATABASE_URL=postgresql://aistack:aistack_local@127.0.0.1:55432/aistack
JD_SCREENSHOT_DIR=./Job Description
JD_OCR_COMMAND=tesseract
# Azure OpenAI vision configuration for fully automatic JD analysis.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21
# Optional Google sign-in (leave blank to run without authentication).
# Create an OAuth client at https://console.cloud.google.com/apis/credentials and add
# ${AUTH_BASE_URL}/auth/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random value of 32+ characters, e.g. `openssl rand -base64 48`.
AUTH_SESSION_SECRET=
AUTH_BASE_URL=http://localhost:3000
# Required when Google sign-in is enabled: the Google account allowed to sign in
# (same variable as nw360). AUTH_ALLOWED_EMAILS (comma-separated) and AUTH_ALLOWED_DOMAINS are optional extras.
AUTH_ALLOWED_EMAIL=you@example.com
AUTH_ALLOWED_EMAILS=
AUTH_ALLOWED_DOMAINS=
